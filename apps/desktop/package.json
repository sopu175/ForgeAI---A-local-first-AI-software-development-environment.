{
  "name": "@forgeai/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "ForgeAI desktop application",
  "main": "./out/main/index.js",
  "author": "ForgeAI",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "clean": "node ../../scripts/clean.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist:mac": "node ../../scripts/clean.mjs && electron-vite build && node ../../scripts/fix-native-bins.mjs && electron-builder --mac && node ../../scripts/prune-mac-apps.mjs",
    "dist:win": "node ../../scripts/clean.mjs && electron-vite build && node ../../scripts/fix-native-bins.mjs && electron-builder --win",
    "dist:dir": "node ../../scripts/clean.mjs && electron-vite build && node ../../scripts/fix-native-bins.mjs && electron-builder --dir",
    "smoke": "electron-vite build && node scripts/smoke.mjs"
  },
  "dependencies": {
    "@forgeai/ai": "0.1.0",
    "@forgeai/core": "0.1.0",
    "@forgeai/shared": "0.1.0",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.105.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^4.0.3",
    "clsx": "^2.1.1",
    "diff": "^8.0.2",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.5",
    "lucide-react": "^0.545.0",
    "monaco-editor": "^0.57.0",
    "nanoid": "^5.1.6",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.16",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/diff": "^7.0.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
